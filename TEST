local rarityPower = {
    Common    = 0,
    Rare      = 50,
    Epic      = 2200,
    Legendary = 33000,
    Mythic    = 225000,
    Godly     = 1050000,
    Secret    = 3600000,
    Hacked    = 75000000,
    OG        = 250000000,
    Celestial = 250000000,
}

local RARITY_ORDER = {"Common","Rare","Epic","Legendary","Mythic","Godly","Secret","Hacked","OG","Celestial","Eternal"}

local function getSliderPercentForRarity(rarity)
    if rarity == "Celestial" or rarity == "Eternal" then return 1 end
    local KickSvc = require(game:GetService("ReplicatedStorage").Modules.ServicesLoader.KickServiceClient)
    local level = KickSvc.Level or 1
    local directRarities = {Common=true,Rare=true,Epic=true,Legendary=true,Mythic=true,Hacked=true}
    local targetRarity = rarity
    if not directRarities[rarity] then
        local idx = table.find(RARITY_ORDER, rarity)
        if idx and idx < #RARITY_ORDER then targetRarity = RARITY_ORDER[idx + 1] end
    end
    local targetPower = rarityPower[targetRarity] or 0
    if targetPower <= 0 then return 0 end
    return math.clamp(targetPower / level, 0, 1)
end

