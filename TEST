do
    local _orig = MystrixHub.FarmController.IsConditionMet
    MystrixHub.FarmController.IsConditionMet = function(attr)
        if _orig(attr) then return true end

        if MystrixHub.CPSFilterController and MystrixHub.CPSFilterController.MinCPS > 0 then
            return false
        end
        if MystrixHub.WeatherMachineController.Running then return false end
        if MystrixHub.AdvancedFiltersController.FilterCount == 0 then return false end
        local parts = {}
        for part in attr:gmatch("[^,]+") do
            table.insert(parts, part:match("^%s*(.-)%s*$"))
        end
        local brainName = parts[1] or ""
        local mutation  = parts[2] or "None"
    

        for _, entry in ipairs(MystrixHub.AdvancedFiltersController.Filters) do
            if not entry.brainrot then continue end
            local brainList = type(entry.brainrot) == "table" and entry.brainrot or {entry.brainrot}
            local brainMatch = false
            for _, b in ipairs(brainList) do
                if b == brainName then
                    brainMatch = true
                    break
                end
            end
            if brainMatch then
                local mutList = type(entry.mutation) == "table" and entry.mutation or {entry.mutation}
                local mutOk = false
                for _, m in ipairs(mutList) do
                    if m == "Any"
                    or m == mutation
                    or (m == "None" and (mutation == "" or mutation == "None" or not mutation))
                    then
                        mutOk = true
                        break
                    end
                end
                if mutOk then return true end
            end
        end
        return false
    end
end

