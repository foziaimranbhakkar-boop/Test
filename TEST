function MystrixHub.Functions.SendInventoryWebhook()
    local url = MystrixHub.WebhookController.URL
    if not url or url == "" then
        WindUI:Notify({ Title = "Inventory Webhook", Content = "Set a webhook URL in Setup first!", Duration = 3, Icon = "alert-circle" })
        return
    end

    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then return end

    local ok1, EntitiesData = pcall(function()
        return require(game:GetService("ReplicatedStorage").Shared.Data.EntitiesData)
    end)
    local ok2, MutationData = pcall(function()
        return require(game:GetService("ReplicatedStorage").Shared.Data.MutationData)
    end)

    local toolData = {}

    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            if ok1 and EntitiesData and not (EntitiesData.Brainrots and EntitiesData.Brainrots[tool.Name]) then
                continue
            end
            local rarity = MystrixHub.Functions.GetRarityOfBrainrot(tool.Name) or "Unknown"
            if rarity == "Unknown" then continue end
            local mutation = tool:GetAttribute("Mutation")
                or tool:GetAttribute("MutationType")
                or tool:GetAttribute("Mut")
                or "None"
            if mutation == "" then mutation = "None" end
            local cpsVal = 0
            if ok1 and ok2 then
                cpsVal = MystrixHub.Functions.GetBrainrotCurrentCPS(tool.Name, mutation) or 0
            end
            table.insert(toolData, {
                name     = tool.Name,
                rarity   = rarity,
                mutation = mutation,
                cps      = cpsVal,
            })
        end
    end

    table.sort(toolData, function(a, b) return a.cps > b.cps end)

    local keyOrder = {}
    local keyMap   = {}

    for _, t in ipairs(toolData) do
        local cpsStr = MystrixHub.Functions.FormatCPSShort(t.cps)
        local key    = t.name .. "|" .. t.rarity .. "|" .. t.mutation .. "|" .. cpsStr
        if keyMap[key] then
            keyMap[key].count = keyMap[key].count + 1
        else
            local entry = {
                name     = t.name,
                rarity   = t.rarity,
                mutation = t.mutation,
                cpsStr   = cpsStr,
                count    = 1,
            }
            keyMap[key] = entry
            table.insert(keyOrder, entry)
        end
    end

    local allLines = {}
    for _, entry in ipairs(keyOrder) do
        local line
        if entry.count > 1 then
            line = string.format("- **[%s] %s x%d** | %s | %s/s",
                entry.rarity, entry.name, entry.count, entry.mutation, entry.cpsStr)
        else
            line = string.format("- **[%s] %s** | %s | %s/s",
                entry.rarity, entry.name, entry.mutation, entry.cpsStr)
        end
        table.insert(allLines, line)
    end

    local CHAR_LIMIT = 4000
    local headerText = "**Brainrots:**\n"
    local totalChars = #headerText
    local usedLines  = {}
    local remaining  = 0

    for i, line in ipairs(allLines) do
        local addition   = line .. "\n"
        local leftover   = #allLines - i
        local moreSuffix = leftover > 0 and ("... and " .. leftover .. " more") or ""
        local projected  = totalChars + #addition + #moreSuffix

        if projected <= CHAR_LIMIT then
            totalChars = totalChars + #addition
            table.insert(usedLines, line)
        else
            remaining = #allLines - #usedLines
            break
        end
    end

    local desc = headerText
    for _, line in ipairs(usedLines) do
        desc = desc .. line .. "\n"
    end
    if remaining > 0 then
        desc = desc .. "\n... and " .. remaining .. " more"
    end

    local totalCount = #toolData
    local payload = {
        username = "Mystrix Hub",
        content  = "@everyone",
        embeds   = {{
            title       = "Backpack Summary — " .. totalCount .. " Brainrots",
            description = desc,
            color       = 0x6c63ff,
            footer      = { text = "Mystrix Hub " .. MystrixHub.Meta.Version .. " | " .. LocalPlayer.Name },
            timestamp   = os.date("!%Y-%m-%dT%H:%M:%SZ"),
        }}
    }

    local okEnc, body = pcall(HttpService.JSONEncode, HttpService, payload)
    if not okEnc or not body then return end

    MystrixHub.Functions.MakeRawRequest(url, "POST", { ["Content-Type"] = "application/json" }, body)
end

