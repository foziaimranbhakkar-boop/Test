local UpgradeLevel1Section = MystrixHub.UIController.Tabs.Brainrots:Section({
    Title  = "Upgrade All Level 1 Brainrots",
    Icon   = "solar:star-bold",
    Box    = true,
    Opened = true,
})
UpgradeLevel1Section:Button({
    Title    = "Upgrade",
    Callback = function()
        task.spawn(function()
            local targetLevel = MystrixHub.UpgradeController.MaxLevel
            local upgradedCount = 0

            local plot = MystrixHub.Functions.GetPlayerPlot()
            if not plot then
                WindUI:Notify({ Title = "Upgrade Level 1", Content = "Could not find your plot!", Duration = 3, Icon = "alert-circle" })
                return
            end

            local occupiedSlots = MystrixHub.Functions.GetOccupiedSlotsSorted(plot)
            for _, slotPart in ipairs(occupiedSlots) do
                local num = tonumber(slotPart.Name:match("%d+"))
                if not num then continue end

                local currentLevel = MystrixHub.Functions.GetSlotBrainrotLevel(slotPart)
                if currentLevel ~= 1 then continue end

                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if not root then continue end

                root.CFrame = slotPart.CFrame * CFrame.new(0, 3, 0)
                task.wait(0.5)

                local attempts = 0
                currentLevel = MystrixHub.Functions.GetSlotBrainrotLevel(slotPart)
                while currentLevel < targetLevel and attempts < 200 do
                    if not slotPart:FindFirstChild("PlacedPart") then break end
                    MystrixHub.Functions.FireRemote("rev_B_Upgrade", num)
                    task.wait(0.05)
                    currentLevel = MystrixHub.Functions.GetSlotBrainrotLevel(slotPart)
                    attempts = attempts + 1
                end

                if currentLevel >= targetLevel then
                    upgradedCount = upgradedCount + 1
                end

                task.wait(0.5)
            end

            local slotsFolder = plot:FindFirstChild("Slots")
            if not slotsFolder then
                WindUI:Notify({
                    Title    = "Upgrade Level 1 Done",
                    Content  = "Finished! Total upgraded: " .. upgradedCount .. " brainrot(s).",
                    Duration = 5,
                    Icon     = "check-circle",
                })
                return
            end

            local EntitiesData
            pcall(function()
                EntitiesData = require(game:GetService("ReplicatedStorage").Shared.Data.EntitiesData)
            end)

            local function getLevel1BrainrotTools()
                local backpack = LocalPlayer:FindFirstChild("Backpack")
                if not backpack then return {} end
                local tools = {}
                for _, tool in ipairs(backpack:GetChildren()) do
                    if tool:IsA("Tool") then
                        local lvl = tonumber(tool:GetAttribute("Level")) or 1
                        if lvl == 1 and (not EntitiesData or EntitiesData.Brainrots[tool.Name]) then
                            table.insert(tools, tool)
                        end
                    end
                end
                return tools
            end

            local function getSlotsInOrder()
                local slots = {}
                for _, slotPart in ipairs(slotsFolder:GetChildren()) do
                    if slotPart:IsA("BasePart") then
                        local num = tonumber(slotPart.Name:match("%d+"))
                        if num and num <= 30 then
                            table.insert(slots, { part = slotPart, num = num })
                        end
                    end
                end
                table.sort(slots, function(a, b) return a.num < b.num end)
                return slots
            end

            local slots = getSlotsInOrder()
            if #slots == 0 then
                WindUI:Notify({
                    Title    = "Upgrade Level 1 Done",
                    Content  = "Finished! Total upgraded: " .. upgradedCount .. " brainrot(s).",
                    Duration = 5,
                    Icon     = "check-circle",
                })
                return
            end

            local slotIndex = 1
            local tools = getLevel1BrainrotTools()

            while #tools > 0 do
                local slotEntry = slots[slotIndex]
                if not slotEntry then break end

                local slotPart = slotEntry.part
                local num = slotEntry.num

                local tool = tools[1]
                if not tool or tool.Parent ~= LocalPlayer:FindFirstChild("Backpack") then
                    tools = getLevel1BrainrotTools()
                    if #tools == 0 then break end
                    tool = tools[1]
                    if not tool then break end
                end

                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local hum  = char and char:FindFirstChildOfClass("Humanoid")
                if not root or not hum then break end

                root.CFrame = slotPart.CFrame * CFrame.new(0, 3, 0)
                task.wait(0.5)

