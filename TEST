function MystrixHub.Functions.SendWeatherEventsWebhook()
    local url = MystrixHub.WebhookController.URL
    if not url or url == "" then
        WindUI:Notify({ Title = "Weather Events Webhook", Content = "Set a webhook URL in Setup first!", Duration = 3, Icon = "alert-circle" })
        return
    end

    local ok, SacrificeData = pcall(function()
        return require(game:GetService("ReplicatedStorage").Shared.Data.SacrificeData)
    end)
    if not ok or not SacrificeData then
        WindUI:Notify({ Title = "Weather Events Webhook", Content = "Could not load recipe data.", Duration = 3, Icon = "alert-circle" })
        return
    end

    local backpack = LocalPlayer:FindFirstChild("Backpack")

    -- Count owned brainrots
    local ownedCounts = {}
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then
                ownedCounts[tool.Name] = (ownedCounts[tool.Name] or 0) + 1
            end
        end
    end

    local events = {"BACON", "Void", "FLOOD", "Phantom"}

    local CHAR_LIMIT = 4000
    local desc = ""
    local remaining_events = 0

    local eventBlocks = {}

    for _, eventName in ipairs(events) do
        local recipe = SacrificeData.Recipes and SacrificeData.Recipes[eventName]
        if not recipe or #recipe == 0 then continue end

        local block = "**" .. eventName .. ":**\n"
        for _, req in ipairs(recipe) do
            if not req.Name or req.Name == "" then continue end
            local rarity = MystrixHub.Functions.GetRarityOfBrainrot(req.Name) or "Unknown"
            local owned  = ownedCounts[req.Name] or 0
            block = block .. string.format("- **[%s] %s x%d**\n", rarity, req.Name, owned)
        end

        table.insert(eventBlocks, block)
    end

    -- Build description respecting char limit
    local usedBlocks = {}
    local totalChars = 0

    for i, block in ipairs(eventBlocks) do
        local leftover   = #eventBlocks - i
        local moreSuffix = leftover > 0 and ("\n... and " .. leftover .. " more events") or ""
        local projected  = totalChars + #block + (i < #eventBlocks and 1 or 0) + #moreSuffix

        if projected <= CHAR_LIMIT then
            totalChars = totalChars + #block + (i < #eventBlocks and 1 or 0)
            table.insert(usedBlocks, block)
        else
            remaining_events = #eventBlocks - #usedBlocks
            break
        end
    end

    for i, block in ipairs(usedBlocks) do
        desc = desc .. block
        if i < #usedBlocks then desc = desc .. "\n" end
    end
    if remaining_events > 0 then
        desc = desc .. "\n... and " .. remaining_events .. " more events"
    end

    if desc == "" then
        WindUI:Notify({ Title = "Weather Events Webhook", Content = "No event recipe data found.", Duration = 3, Icon = "alert-circle" })
        return
    end

    local payload = {
        username = "Mystrix Hub",
        content  = "@everyone",
        embeds   = {{
            title       = "Weather Events — " .. LocalPlayer.Name,
            description = desc,
            color       = 0x00d4ff,
            footer      = { text = "Mystrix Hub " .. MystrixHub.Meta.Version .. " | " .. LocalPlayer.Name },
            timestamp   = os.date("!%Y-%m-%dT%H:%M:%SZ"),
        }}
    }

    local okEnc, body = pcall(HttpService.JSONEncode, HttpService, payload)
    if not okEnc or not body then return end

    MystrixHub.Functions.MakeRawRequest(url, "POST", { ["Content-Type"] = "application/json" }, body)
end
