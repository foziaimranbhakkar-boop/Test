    if MystrixHub.WeatherMachineController.StartedFarm and MystrixHub.FarmController.Running then
        MystrixHub.FarmController.Stop()
        MystrixHub.WeatherMachineController.StartedFarm = false
    end
end

MystrixHub.ActivateEventsController.Start = function()
    if MystrixHub.ActivateEventsController.Loop then
        task.cancel(MystrixHub.ActivateEventsController.Loop)
    end
    local SacrificeData
    pcall(function() SacrificeData = require(game:GetService("ReplicatedStorage").Shared.Data.SacrificeData) end)
    MystrixHub.ActivateEventsController.AutoActivate = true
    MystrixHub.ActivateEventsController.Loop = task.spawn(function()
        while MystrixHub.ActivateEventsController.AutoActivate do
            for _, eventName in ipairs(MystrixHub.ActivateEventsController.SelectedEvents) do
                if not MystrixHub.ActivateEventsController.AutoActivate then break end
                if not SacrificeData then continue end
                local recipe = SacrificeData.Recipes[eventName]
                if not recipe or #recipe == 0 then continue end
                local allMet = true
                local bp = LocalPlayer:FindFirstChild("Backpack")
                for _, req in ipairs(recipe) do
                    if not req.Name then allMet = false break end
                    local found = false
                    if bp then
                        for _, tool in ipairs(bp:GetChildren()) do
                            if tool:IsA("Tool") and tool.Name == req.Name then
                                local mutOk = (not req.Mutation) or req.Mutation == "Any"
                                    or tool:GetAttribute("Mutation") == req.Mutation
                                if mutOk then found = true break end
                            end
                        end
                    end
                    if not found then allMet = false break end
                end
                if allMet then
                    pcall(function() MystrixHub.Functions.FireRemote("rev_sbe", eventName) end)
                    WindUI:Notify({ Title = "Activate Events", Content = "Activated: " .. eventName, Duration = 3, Icon = "zap" })
                end
            end
            task.wait(5)
        end
    end)
end

