local function AddAdvancedFilterPair()
    if MystrixHub.AdvancedFiltersController.AddButton then
        pcall(function() MystrixHub.AdvancedFiltersController.AddButton:Destroy() end)
        MystrixHub.AdvancedFiltersController.AddButton = nil
    end

    MystrixHub.AdvancedFiltersController.FilterCount += 1
    local idx   = MystrixHub.AdvancedFiltersController.FilterCount
    local entry = { brainrot = nil, mutation = "Any" }
    table.insert(MystrixHub.AdvancedFiltersController.Filters, entry)

    if not MystrixHub.UIController.Drops.AdvancedFilters then
        MystrixHub.UIController.Drops.AdvancedFilters = {}
    end

    local brainrotDropdown = AdvFiltersSection:Dropdown({
        Title            = "Brainrot",
        Values           = advBrainrotList,
        Multi            = true,
        AllowNone        = true,
        SearchBarEnabled = true,
        Flag             = "AdvFlt_B_" .. idx,
        Callback         = function(v)
            entry.brainrot = (v and #v > 0) and v or nil
        end,
    })

    local mutationDropdown = AdvFiltersSection:Dropdown({
        Title     = "Mutation",
        Values    = advMutList,
        Multi     = true,
        AllowNone = true,
        Value     = {"Any"},
        Flag      = "AdvFlt_M_" .. idx,
        Callback  = function(v)
            entry.mutation = (v and #v > 0) and v or {"Any"}
        end,
    })

    MystrixHub.UIController.Drops.AdvancedFilters[idx] = {
        Brainrot = brainrotDropdown,
        Mutation = mutationDropdown,
    }

    MystrixHub.AdvancedFiltersController.TopDivider = AdvFiltersSection:Divider()

    MystrixHub.AdvancedFiltersController.AddButton = AdvFiltersSection:Button({
        Title    = "Add Another Filter",
        Icon     = "plus-circle",
        Callback = function()
            task.spawn(function()
                task.wait()
                AddAdvancedFilterPair()
            end)
        end,
    })
end

