MiscSection:Toggle({
    Title    = "Infinite Jump",
    Value    = false,
    Flag     = "InfJump",
    Callback = function(state)
        if state then
            if MystrixHub.InfJumpConn then
                MystrixHub.InfJumpConn:Disconnect()
            end
            local UserInputService = game:GetService("UserInputService")
            MystrixHub.InfJumpConn = UserInputService.JumpRequest:Connect(function()
                local char = LocalPlayer.Character
                if not char then return end
                local hum = char:FindFirstChildOfClass("Humanoid")
                if not hum then return end
                local s = hum:GetState()
                if s == Enum.HumanoidStateType.Freefall or s == Enum.HumanoidStateType.Jumping then
                    hum:ChangeState(Enum.HumanoidStateType.Jumping)
                end
            end)
        else
            if MystrixHub.InfJumpConn then
                MystrixHub.InfJumpConn:Disconnect()
                MystrixHub.InfJumpConn = nil
            end
        end
    end,
})

MiscSection:Toggle({
    Title    = "Quick Interact",
    Value    = false,
    Flag     = "QuickInteract",
    Callback = function(state)
        if state then
            MystrixHub.PromptBackup = MystrixHub.PromptBackup or {}
            local backup = MystrixHub.PromptBackup
            local conn
            conn = workspace.DescendantAdded:Connect(function(obj)
                if obj:IsA("ProximityPrompt") then
                    backup[obj] = { hold = obj.HoldDuration, line = obj.RequiresLineOfSight }
                    obj.HoldDuration = 0
                    obj.RequiresLineOfSight = false
                end
            end)
            MystrixHub.QuickInteractConn = conn
            for _, prompt in ipairs(workspace:GetDescendants()) do
                if prompt:IsA("ProximityPrompt") then
                    backup[prompt] = { hold = prompt.HoldDuration, line = prompt.RequiresLineOfSight }
                    prompt.HoldDuration = 0
                    prompt.RequiresLineOfSight = false
                end
            end
        else
            if MystrixHub.QuickInteractConn then
                MystrixHub.QuickInteractConn:Disconnect()
                MystrixHub.QuickInteractConn = nil
            end

            local backup = MystrixHub.PromptBackup
            if backup then
                for prompt, orig in pairs(backup) do
                    pcall(function()
                        prompt.HoldDuration = orig.hold
                        prompt.RequiresLineOfSight = orig.line
                    end)
                end
                table.clear(backup)
            end
        end
    end,
})


local PerformanceSection = LeftVStack:Section({ Title = "Performance", Icon = "cpu", Box = true, Opened = true })

PerformanceSection:Toggle({
    Title    = "Hide Players",
    Value    = false,
    Flag     = "HidePlayers",
    Callback = function(state)
        local Players = game:GetService("Players")

        local function hide(plr)
            local char = plr.Character
            if not char then return end
            for _, obj in ipairs(char:GetDescendants()) do
                if obj:IsA("BasePart") or obj:IsA("Decal") or obj:IsA("Texture") then
                    obj.LocalTransparencyModifier = 1
                elseif obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
                    obj.Enabled = false
                end
            end
            for _, tag in ipairs(char:GetChildren()) do
                if tag:IsA("BillboardGui") or tag:IsA("SurfaceGui") then
                    tag.Enabled = false
                end
            end
        end

        local function unhide(plr)
            local char = plr.Character
            if not char then return end
            for _, obj in ipairs(char:GetDescendants()) do
                if obj:IsA("BasePart") or obj:IsA("Decal") or obj:IsA("Texture") then
                    obj.LocalTransparencyModifier = 0
                elseif obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
                    obj.Enabled = true
                end
            end
            for _, tag in ipairs(char:GetChildren()) do
                if tag:IsA("BillboardGui") or tag:IsA("SurfaceGui") then
                    tag.Enabled = true
                end
            end
        end

        if state then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer then hide(plr) end
            end
            local addConn = Players.PlayerAdded:Connect(function(plr)
                if plr ~= LocalPlayer then
                    hide(plr)
                    plr.CharacterAdded:Connect(function() hide(plr) end)
                end
            end)
            local respawnConns = {}
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer then
                    local c = plr.CharacterAdded:Connect(function() hide(plr) end)
                    table.insert(respawnConns, c)
                end
            end
            MystrixHub.HidePlayersStuff = { addConn, respawnConns }
        else
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer then unhide(plr) end
            end
            if MystrixHub.HidePlayersStuff then
                MystrixHub.HidePlayersStuff[1]:Disconnect()
                for _, c in ipairs(MystrixHub.HidePlayersStuff[2]) do c:Disconnect() end
                MystrixHub.HidePlayersStuff = nil
            end
        end
    end,
})


PerformanceSection:Toggle({
    Title    = "Hide Plots",
    Value    = false,
    Flag     = "HidePlots",
    Callback = function(state)
        local plots = workspace:FindFirstChild("Plots")
        if not plots then return end

        local function hideAll(obj)
            if obj:IsA("BasePart") or obj:IsA("MeshPart") then
                obj.LocalTransparencyModifier = 1
                obj.CanCollide = false
                obj.CanQuery = false
                obj.CanTouch = false
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                obj.LocalTransparencyModifier = 1
            elseif obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
                obj.Enabled = false
            elseif obj:IsA("ParticleEmitter") or obj:IsA("Beam") or obj:IsA("Trail") or obj:IsA("Light") or obj:IsA("Sparkles") then
                obj.Enabled = false
            elseif obj:IsA("ProximityPrompt") then
                obj.Enabled = false
            end
        end

        local function unhideAll(obj)
            if obj:IsA("BasePart") or obj:IsA("MeshPart") then
                obj.LocalTransparencyModifier = 0
                obj.CanCollide = true
                obj.CanQuery = true
                obj.CanTouch = true
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                obj.LocalTransparencyModifier = 0
            elseif obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
                obj.Enabled = true
            elseif obj:IsA("ParticleEmitter") or obj:IsA("Beam") or obj:IsA("Trail") or obj:IsA("Light") or obj:IsA("Sparkles") then
                obj.Enabled = true
            elseif obj:IsA("ProximityPrompt") then
                obj.Enabled = true
            end
        end

        if state then
            for _, plot in ipairs(plots:GetChildren()) do
                if plot:GetAttribute("Owner") ~= LocalPlayer.Name then
                    for _, desc in ipairs(plot:GetDescendants()) do hideAll(desc) end
                end
            end
            local conn = plots.ChildAdded:Connect(function(plot)
                if plot:GetAttribute("Owner") ~= LocalPlayer.Name then
                    for _, desc in ipairs(plot:GetDescendants()) do hideAll(desc) end
                end
            end)
            MystrixHub.HidePlotsConn = conn
        else
            for _, plot in ipairs(plots:GetChildren()) do
                for _, desc in ipairs(plot:GetDescendants()) do unhideAll(desc) end
            end
            if MystrixHub.HidePlotsConn then
                MystrixHub.HidePlotsConn:Disconnect()
                MystrixHub.HidePlotsConn = nil
            end
        end
    end,
})


