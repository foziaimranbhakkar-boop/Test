local function SendTradeBatch(targetId, itemsBatch, batchNumber, totalBatches)
    if not targetId or #itemsBatch == 0 then return false end

    MystrixHub.GiftController.DebounceExpiry = 0


    pcall(function()
        TradeNetwork:WaitForChild("ref_trade_r"):InvokeServer(targetId)
    end)

    local tradeStarted = false
    local startConn
    startConn = TradeNetwork:WaitForChild("rev_trade_s").OnClientEvent:Connect(function(status)
        if status == "Trading" then
            tradeStarted = true
        end
    end)
    local t0 = tick()
    while not tradeStarted and tick() - t0 < 20 do
        task.wait(0.2)
    end
    startConn:Disconnect()
    if not tradeStarted then return false end

    task.wait(0.4)


    for _, tool in ipairs(itemsBatch) do
        local guid = tool:GetAttribute("GUID")
        if guid then
            task.wait(0.3)
            pcall(function()
                TradeNetwork:WaitForChild("rev_trade_i"):FireServer("AddItem", guid)
            end)
        end
    end

    task.wait(5.1)


    pcall(function() TradeNetwork:WaitForChild("rev_trade_i"):FireServer("Confirm") end)
    WindUI:Notify({
        Title = "Trade Batch",
        Content = string.format("Batch %d/%d - Round 1 confirmed!", batchNumber, totalBatches),
        Duration = 2,
        Icon = "check-circle"
    })


    local finalArrived = false
    local finalConn
    finalConn = TradeNetwork:WaitForChild("rev_trade_u").OnClientEvent:Connect(function(data)
        if data and data.Stage == "Final" then
            finalArrived = true
        end
    end)
    local tradeCancelled = false
    local cancelConn = TradeNetwork:WaitForChild("rev_trade_s").OnClientEvent:Connect(function(status)
        if status == "Cancelled" then tradeCancelled = true end
    end)

    local waitStart = tick()
    while not finalArrived and not tradeCancelled and tick() - waitStart < 60 do
        task.wait(0.2)
    end
    finalConn:Disconnect()
    cancelConn:Disconnect()

    if finalArrived and not tradeCancelled then
        task.wait(5.1)
        pcall(function() TradeNetwork:WaitForChild("rev_trade_i"):FireServer("Confirm") end)
        WindUI:Notify({
            Title = "Trade Batch",
            Content = string.format("Batch %d/%d - Final confirmed!", batchNumber, totalBatches),
            Duration = 2,
            Icon = "check-circle"
        })


        local tradeEnded = false
        local endConn
        endConn = TradeNetwork:WaitForChild("rev_trade_s").OnClientEvent:Connect(function(status)
            if status == "Cancelled" then
                tradeEnded = true
                MystrixHub.GiftController.InTrade = false
            end
        end)
        local endStart = tick()
        while not tradeEnded and tick() - endStart < 30 do
            task.wait(0.2)
        end
        endConn:Disconnect()
        WaitForDebounce()
        task.wait(1.5)
        return true
    else


        local endConn2
        endConn2 = TradeNetwork:WaitForChild("rev_trade_s").OnClientEvent:Connect(function(status)
            if status == "Cancelled" then
                MystrixHub.GiftController.InTrade = false
            end
        end)
        task.wait(2)
        endConn2:Disconnect()
        WaitForDebounce()
        task.wait(1)
        return false
    end
end


TradeAmountSection:Button({
    Title = "Trade",
    Icon = "send",
    Callback = function()
        task.spawn(function()
            local targetId = MystrixHub.GiftController.TargetUserId
            if not targetId then
                WindUI:Notify({ Title = "Trade Specific", Content = "Select a target player first!", Duration = 3, Icon = "alert-circle" })
                return
            end

            local amount = _G.TradeAmountValue or 10
            if amount < 1 then amount = 1 end

            local allTools = GetTradableToolsList()
            if #allTools == 0 then
                WindUI:Notify({ Title = "Trade Specific", Content = "No brainrots match your filters!", Duration = 3, Icon = "alert-circle" })
                return
            end

            local toSend = {}
            for i = 1, math.min(amount, #allTools) do
                table.insert(toSend, allTools[i])
            end

            if #toSend == 0 then
                WindUI:Notify({ Title = "Trade Specific", Content = "Not enough brainrots available.", Duration = 3, Icon = "alert-circle" })
                return
            end

            WindUI:Notify({
                Title = "Trade Specific",
                Content = string.format("Sending %d brainrot(s) in batches of up to 10...", #toSend),
                Duration = 3,
                Icon = "loader-2"
            })

            local batches = {}
            local currentBatch = {}
            for i, tool in ipairs(toSend) do
                table.insert(currentBatch, tool)
                if #currentBatch == 10 then
                    table.insert(batches, currentBatch)
                    currentBatch = {}
                end
            end
            if #currentBatch > 0 then
                table.insert(batches, currentBatch)
            end

            local totalBatches = #batches
            local sent = 0

            for idx, batchItems in ipairs(batches) do


                while MystrixHub.GiftController.InTrade do
                    task.wait(0.5)
                end

                local success = SendTradeBatch(targetId, batchItems, idx, totalBatches)
                if success then
                    sent = sent + #batchItems
                    WindUI:Notify({
                        Title = "Trade Specific",
                        Content = string.format("Batch %d/%d done (%d total sent)", idx, totalBatches, sent),
                        Duration = 2,
                        Icon = "check-circle"
                    })
                else
                    WindUI:Notify({
                        Title = "Trade Specific",
                        Content = string.format("Batch %d failed. Stopping.", idx),
                        Duration = 3,
                        Icon = "alert-circle"
                    })
                    break
                end

                task.wait(0.5)
            end

            WindUI:Notify({
                Title = "Trade Specific",
                Content = string.format("Finished! Sent %d of %d brainrot(s).", sent, #toSend),
                Duration = 4,
                Icon = sent == #toSend and "check-circle" or "alert-circle"
            })
        end)
    end,
})

