    Callback = function(state)
        for _, key in ipairs({"AutoAcceptConn","AutoConfirmConn","AutoConfirmUpdateConn"}) do
            if MystrixHub.GiftController[key] then
                MystrixHub.GiftController[key]:Disconnect()
                MystrixHub.GiftController[key] = nil
            end
        end

        MystrixHub.GiftController.AutoConfirmEnabled = state
        if not state then return end

        local partnerId = nil
        local round1Done = false
        local round2Done = false

        local function resetState()
            partnerId = nil
            round1Done = false
            round2Done = false
        end

        MystrixHub.GiftController.AutoAcceptConn =
            TradeNetwork:WaitForChild("rev_trade_n").OnClientEvent:Connect(function(senderUserId, expiry)
                if (expiry - workspace:GetServerTimeNow()) < 1 then return end
                task.wait(0.2)
                partnerId = senderUserId
                round1Done = false
                round2Done = false
                MystrixHub.GiftController.DebounceExpiry = 0
                pcall(function()
                    TradeNetwork:WaitForChild("rev_trade_start"):FireServer(senderUserId)
                end)
            end)

        MystrixHub.GiftController.AutoConfirmConn =
            TradeNetwork:WaitForChild("rev_trade_s").OnClientEvent:Connect(function(status, partnerPlayer)
                if status == "Trading" then
                    if partnerPlayer and partnerPlayer.UserId then
                        partnerId = partnerPlayer.UserId
                    end
                    round1Done = false
                    round2Done = false
                    MystrixHub.GiftController.DebounceExpiry = 0
                elseif status == "Cancelled" then
                    resetState()
                    MystrixHub.GiftController.DebounceExpiry = 0
                end
            end)

        MystrixHub.GiftController.AutoConfirmUpdateConn =
            TradeNetwork:WaitForChild("rev_trade_u").OnClientEvent:Connect(function(data)
                if not MystrixHub.GiftController.AutoConfirmEnabled then return end
                if not data then return end

                if data.Debounce then
                    MystrixHub.GiftController.DebounceExpiry = data.Debounce
                end

                local stage = data.Stage

                if not round1Done and (stage == "Trade" or stage == nil) then
                    local partnerConfirmed = data.Confirmations
                        and partnerId
                        and data.Confirmations[tostring(partnerId)]
                    if partnerConfirmed then
                        round1Done = true
                        task.spawn(function()
                            WaitForDebounce()
                            if not MystrixHub.GiftController.AutoConfirmEnabled then return end
                            pcall(function()
                                TradeNetwork:WaitForChild("rev_trade_i"):FireServer("Confirm")
                            end)
                            WindUI:Notify({
                                Title    = "Trade",
                                Content  = "Auto‑confirmed (Round 1)!",
                                Duration = 3,
                                Icon     = "check-circle",
                            })
                        end)
                    end
                end

                if not round2Done and stage == "Final" then
                    round2Done = true
                    task.spawn(function()
                        task.wait(11)   
                        if not MystrixHub.GiftController.AutoConfirmEnabled then return end
                        pcall(function()
                            TradeNetwork:WaitForChild("rev_trade_i"):FireServer("Confirm")
                        end)
                        WindUI:Notify({
                            Title    = "Trade",
                            Content  = "Auto‑confirmed final!",
                            Duration = 3,
                            Icon     = "check-circle",
