local function matchesFavFilters(tool)
    if not tool:IsA("Tool") then return false end

    local mutFilter = MystrixHub.UIController.Drops.FavMutation and MystrixHub.UIController.Drops.FavMutation.Value or {"Any"}
    local mutOk = false
    if table.find(mutFilter, "Any") then
        mutOk = true
    else
        local mut = tool:GetAttribute("Mutation")
            or tool:GetAttribute("MutationType")
            or "None"
        if mut == "" or not mut then mut = "None" end
        mutOk = table.find(mutFilter, mut) ~= nil
    end
    if not mutOk then return false end

    local specificFilter = MystrixHub.UIController.Drops.FavSpecific and MystrixHub.UIController.Drops.FavSpecific.Value or {}
    if #specificFilter > 0 then
        return table.find(specificFilter, tool.Name) ~= nil
    end

    local rarityFilter = MystrixHub.UIController.Drops.FavRarity and MystrixHub.UIController.Drops.FavRarity.Value or {}
    if #rarityFilter > 0 then
        local rarity = MystrixHub.Functions.GetRarityOfBrainrot(tool.Name)
        if rarity and table.find(rarityFilter, rarity) then
            return true
        end
        return false
    end

    return false
end

local function favouriteMatchingTools()

    local toolsToFav = {}
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        for _, tool in ipairs(bp:GetChildren()) do
            if tool:IsA("Tool") and matchesFavFilters(tool) and not tool:GetAttribute("Favorite") then
                table.insert(toolsToFav, tool)
            end
        end
    end
    local char = LocalPlayer.Character
    if char then
        local equipped = char:FindFirstChildOfClass("Tool")
        if equipped and matchesFavFilters(equipped) and not equipped:GetAttribute("Favorite") then
            table.insert(toolsToFav, equipped)
        end
    end


    for _, tool in ipairs(toolsToFav) do
        local guid = tool:GetAttribute("GUID")
        if guid then
            pcall(function()
                MystrixHub.Functions.FireRemote("rev_ToggleFav", guid)
            end)
            task.wait(0.3)   
        end
    end
end

