    end
end

function MystrixHub.Functions.GetBrainrotCurrentCPS(brainName, mutation)
    mutation = mutation or "None"
    local ok1, EntitiesData = pcall(function()
        return require(game:GetService("ReplicatedStorage").Shared.Data.EntitiesData)
    end)
    local ok2, MutationData = pcall(function()
        return require(game:GetService("ReplicatedStorage").Shared.Data.MutationData)
    end)
    if not ok1 or not ok2 or not EntitiesData or not MutationData then return nil end
    local brainrot = EntitiesData.Brainrots and EntitiesData.Brainrots[brainName]
    if not brainrot or not brainrot.CPS then return nil end
    local ok3, baseCPS = pcall(function() return brainrot.CPS:Reverse() end)
    if not ok3 or not baseCPS then return nil end
    local mutValue = (MutationData.Buffs and MutationData.Buffs[mutation]
        and MutationData.Buffs[mutation].Value) or 1
    return baseCPS * mutValue  
end

function MystrixHub.Functions.FormatCPSShort(rawCPS)
    if not rawCPS then return "N/A" end
    if rawCPS >= 1e9 then
        return string.format("%.2fB", rawCPS / 1e9)
    elseif rawCPS >= 1e6 then
        return string.format("%.2fM", rawCPS / 1e6)
    elseif rawCPS >= 1e3 then
        return string.format("%.2fK", rawCPS / 1e3)
    else
        return string.format("%.2f", rawCPS)
    end
end

