function MystrixHub.FarmController.TweenTo(root, target)
    target = Vector3.new(target.X, 10, target.Z)

    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    -- Anchor + kill humanoid physics so nothing fights the tween
    if hum then hum:ChangeState(Enum.HumanoidStateType.Physics) end
    root.Anchored = true
    root.CFrame = CFrame.new(root.Position.X, 10, root.Position.Z)

    local speed = hum and (hum.WalkSpeed + 99) or 99
    local distance = (target - root.Position).Magnitude
    local duration = distance / speed
    if duration <= 0 then duration = 0.01 end

    local tween = TweenService:Create(
        root,
        TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
        { CFrame = CFrame.new(target) }
    )
    tween:Play()
    tween.Completed:Wait()

    root.Anchored = false
    if hum then hum:ChangeState(Enum.HumanoidStateType.Freefall) end
end

