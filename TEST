local function GiftMutationOk(tool)
    local filter = MystrixHub.GiftController.SelectedMutations
    if table.find(filter, "Any") then return true end
    local mut = tool:GetAttribute("Mutation")
        or tool:GetAttribute("MutationType")
        or tool:GetAttribute("Mut")
        or "None"
    return table.find(filter, mut) ~= nil
end

local TRADE_ITEM_LIMIT = 10

local function FindAllTradableTools()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then return {} end

    local hasSpecific = #MystrixHub.GiftController.SelectedSpecific > 0
    local hasRarity   = #MystrixHub.GiftController.SelectedRarities > 0
    local results     = {}

    for _, tool in ipairs(backpack:GetChildren()) do
        if #results >= TRADE_ITEM_LIMIT then break end
        if not tool:IsA("Tool") then continue end
        if tool:GetAttribute("TradeLocked") then continue end
        if not GiftMutationOk(tool) then continue end

        if hasSpecific then
            local toolRarity = MystrixHub.Functions.GetRarityOfBrainrot(tool.Name)
            local display = toolRarity and ("[" .. toolRarity .. "] " .. tool.Name) or tool.Name
            if table.find(MystrixHub.GiftController.SelectedSpecific, display) then
                table.insert(results, tool)
            end
        elseif hasRarity then
            local rarity = MystrixHub.Functions.GetRarityOfBrainrot(tool.Name)
            if rarity and table.find(MystrixHub.GiftController.SelectedRarities, rarity) then
                table.insert(results, tool)
            end
        end
    end
    return results
end

