ConfigSection:Button({
    Title    = "Import Config",
    Icon     = "download",
    Callback = function()
        task.spawn(function()
            local raw = MystrixHub.ConfigController.ImportData or ""
            if raw == "" then
                WindUI:Notify({ Title = "Import Failed", Content = "Paste a config string into the input above first!", Duration = 3, Icon = "alert-circle" })
                return
            end

            local ok, decoded = pcall(function() return HttpService:JSONDecode(raw) end)
            if not ok or type(decoded) ~= "table" or not decoded.mhub or not decoded.data or not decoded.name then
                WindUI:Notify({ Title = "Invalid Config", Content = "That doesn't look like a valid Mystrix Hub config!", Duration = 4, Icon = "alert-circle" })
                return
            end

            local dataOk = pcall(function() return HttpService:JSONDecode(decoded.data) end)
            if not dataOk then
                WindUI:Notify({ Title = "Corrupt Config", Content = "Config data is malformed!", Duration = 4, Icon = "alert-circle" })
                return
            end

            local configName = tostring(decoded.name)

            pcall(function() makefolder("WindUI") end)
            pcall(function() makefolder(MystrixHub.Meta.FolderPath) end)
            local configDir = MystrixHub.Meta.FolderPath .. "/Config"
            pcall(function() makefolder(configDir) end)

            local writePath = configDir .. "/" .. configName .. ".json"
            local writeOk = pcall(writefile, writePath, decoded.data)

            if not writeOk then
                WindUI:Notify({ Title = "Import Failed", Content = "Could not write config file to disk!", Duration = 3, Icon = "alert-circle" })
                return
            end

            task.wait(0.5)

            MystrixHub.ConfigController.Cache[configName] = nil

            local config = MystrixHub.ConfigController.GetConfig(configName)
            local loadOk, loadErr = pcall(function() config:Load() end)

            if loadOk then
                    task.wait(0.1)
    MystrixHub.Functions.SyncDropdownsToState()
                MystrixHub.ConfigController.SaveLastConfigName(configName)
                pcall(function()
                    MystrixHub.ConfigController.Dropdown:Refresh(MystrixHub.ConfigController.GetAllConfigNames())
                    MystrixHub.ConfigController.Dropdown.Value = configName
                    MystrixHub.ConfigController.SelectedConfig = configName
                end)
                WindUI:Notify({
                    Title    = "Config Imported & Loaded!",
                    Content  = "Successfully applied: " .. configName .. (decoded.v and (" [" .. decoded.v .. "]") or ""),
                    Duration = 5,
                    Icon     = "check-circle",
                })
            else
                WindUI:Notify({
                    Title    = "Import Failed to Apply",
                    Content  = "File written but could not be loaded.\nError: " .. tostring(loadErr),
                    Duration = 5,
                    Icon     = "alert-circle",
                })
            end
        end)
    end,
})

