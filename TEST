MystrixHub.WeatherMachineController.Start = function()
    if MystrixHub.WeatherMachineController.Running then return end
    local event = MystrixHub.WeatherMachineController.SelectedEvent
    if not event or event == "" then
        WindUI:Notify({ Title = "Weather Machine", Content = "No event selected.", Duration = 3, Icon = "alert-circle" })
        return
    end
    MystrixHub.WeatherMachineController.Running = true
    MystrixHub.WeatherMachineController.SavedSettings = {
        Specific  = MystrixHub.FarmController.SelectedSpecific,
        Rarities  = MystrixHub.FarmController.SelectedRarities,
        Mutations = MystrixHub.FarmController.SelectedMutations,
        Percent   = MystrixHub.FarmController.KickPercent,
    }
    if not MystrixHub.FarmController.Running then
        MystrixHub.FarmController.Start()
        MystrixHub.WeatherMachineController.StartedFarm = true
    end
    MystrixHub.WeatherMachineController.Loop = task.spawn(function()
        local ok, SacrificeData = pcall(function()
            return require(game:GetService("ReplicatedStorage").Shared.Data.SacrificeData)
        end)
        if not ok or not SacrificeData then
            WindUI:Notify({ Title = "Weather Machine", Content = "Could not load recipe data.", Duration = 3, Icon = "alert-circle" })
            MystrixHub.WeatherMachineController.Running = false
            return
        end
        local recipe = SacrificeData.Recipes[event]
        if not recipe or #recipe == 0 then
            WindUI:Notify({ Title = "Weather Machine", Content = event .. " has no recipe data.", Duration = 3, Icon = "alert-circle" })
            MystrixHub.WeatherMachineController.Running = false
            return
        end
        local KickSvc = require(game:GetService("ReplicatedStorage").Modules.ServicesLoader.KickServiceClient)
        local requirements = {}
        for _, req in ipairs(recipe) do
            if req.Name and req.Name ~= "" then table.insert(requirements, req) end
        end
        if #requirements == 0 then
            WindUI:Notify({ Title = "Weather Machine", Content = event .. " has no valid brainrots.", Duration = 3, Icon = "alert-circle" })
            MystrixHub.WeatherMachineController.Running = false
            return
        end
        table.sort(requirements, function(a, b)
            local rarityAsc = {Common=1,Rare=2,Epic=3,Legendary=4,Mythic=5,Godly=6,Secret=7,Divine=8,Hacked=9,OG=10,Celestial=11,Eternal=12}
            local ra = a.Name and MystrixHub.Functions.GetRarityOfBrainrot(a.Name) or "Common"
            local rb = b.Name and MystrixHub.Functions.GetRarityOfBrainrot(b.Name) or "Common"
            return (rarityAsc[ra] or 99) < (rarityAsc[rb] or 99)
        end)
        local keepList = MystrixHub.WeatherMachineController.KeepBrainrots or {"None"}
        local keepSet = {}
        for _, name in ipairs(keepList) do
            if name ~= "None" then keepSet[name] = true end
        end
        WindUI:Notify({ Title = "Weather Machine", Content = "Starting: " .. event, Duration = 3, Icon = "cloud-lightning" })
        while MystrixHub.WeatherMachineController.Running do
            for _, req in ipairs(requirements) do
                if not MystrixHub.WeatherMachineController.Running then break end
                local brainName = req.Name
                local rarity = MystrixHub.Functions.GetRarityOfBrainrot(brainName) or "Common"
                local neededPercent = getSliderPercentForRarity(rarity)
                SliderChanged:Fire(neededPercent)
                MystrixHub.FarmController.KickPercent = neededPercent
                KickSvc.Percent = neededPercent
                task.wait(0.05)
                local keepSpecific = {brainName}
                for name in pairs(keepSet) do table.insert(keepSpecific, name) end
                MystrixHub.FarmController.SelectedSpecific = keepSpecific
                MystrixHub.FarmController.SelectedRarities = {}
                MystrixHub.FarmController.SelectedMutations = {"Any"}
                WindUI:Notify({
                    Title   = "Weather Machine",
                    Content = string.format("Farming %s [%s] for %s", brainName, rarity, event),
                    Duration = 3, Icon = "cloud-lightning",
                })
                local bp = LocalPlayer:FindFirstChild("Backpack")
                local startCount = 0
                if bp then
                    for _, tool in ipairs(bp:GetChildren()) do
                        if tool:IsA("Tool") and tool.Name == brainName then startCount += 1 end
                    end
                end
                local timeout, waited = 300, 0
                while MystrixHub.WeatherMachineController.Running and waited < timeout do
                    local newCount = 0
                    local bp2 = LocalPlayer:FindFirstChild("Backpack")
                    if bp2 then
                        for _, tool in ipairs(bp2:GetChildren()) do
                            if tool:IsA("Tool") and tool.Name == brainName then newCount += 1 end
                        end
                    end
                    if newCount > startCount then break end
                    task.wait(0.3)
                    waited += 0.3
                end
            end
            if MystrixHub.WeatherMachineController.Running then
                WindUI:Notify({ Title = "Weather Machine", Content = "✅ " .. event .. " set complete! Restarting...", Duration = 4, Icon = "check-circle" })
            end
        end
        local saved = MystrixHub.WeatherMachineController.SavedSettings
        MystrixHub.FarmController.SelectedSpecific  = saved.Specific or {}
        MystrixHub.FarmController.SelectedRarities  = saved.Rarities or {}
        MystrixHub.FarmController.SelectedMutations = saved.Mutations or {"Any"}
        MystrixHub.FarmController.KickPercent       = saved.Percent or 1
        KickSvc.Percent = saved.Percent or 1
        MystrixHub.WeatherMachineController.Running = false
        if MystrixHub.WeatherMachineController.StartedFarm and MystrixHub.FarmController.Running then
            MystrixHub.FarmController.Stop()
            MystrixHub.WeatherMachineController.StartedFarm = false
        end
    end)
end

MystrixHub.WeatherMachineController.Stop = function()
    MystrixHub.WeatherMachineController.Running = false
    if MystrixHub.WeatherMachineController.Loop then
        task.cancel(MystrixHub.WeatherMachineController.Loop)
        MystrixHub.WeatherMachineController.Loop = nil
    end
    local saved = MystrixHub.WeatherMachineController.SavedSettings
    if saved then
        MystrixHub.FarmController.SelectedSpecific  = saved.Specific or {}
        MystrixHub.FarmController.SelectedRarities  = saved.Rarities or {}
        MystrixHub.FarmController.SelectedMutations = saved.Mutations or {"Any"}
