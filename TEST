function MystrixHub.Functions.SellBrainrotsByCPS()
    if MystrixHub.SellCPSController.MinCPS <= 0 then
        WindUI:Notify({ Title = "CPS Sell", Content = "CPS filter not set!", Duration = 3, Icon = "alert-circle" })
        return
    end
    local minRaw   = MystrixHub.SellCPSController.MinCPS * 1000
    local character = LocalPlayer.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
