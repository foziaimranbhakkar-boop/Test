local function WaitForDebounce()
    local MAX_WAIT = 12
    local waited   = 0
    while workspace:GetServerTimeNow() < MystrixHub.GiftController.DebounceExpiry do
        local remaining = MystrixHub.GiftController.DebounceExpiry - workspace:GetServerTimeNow()
        if remaining <= 0 then break end
        task.wait(math.min(remaining + 0.1, 0.2))
        waited = waited + 0.2
        if waited >= MAX_WAIT then break end
    end
    task.wait(0.15)
end

